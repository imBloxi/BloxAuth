# Copy to your web server or hosting panel's environment settings.
# BloxAuth reads these with getenv(); nothing secret belongs in the code.

# Database
DB_HOST=localhost
DB_NAME=roblox_licensing
DB_USER=bloxauth
DB_PASS=change-me
# DB_SSL_CA=/path/to/server-ca.pem

# Public URL of this install, no trailing slash (leave empty for relative links)
APP_URL=https://auth.example.com
APP_NAME=BloxAuth

# Captcha on signup (enabled when the secret is set)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Roblox OAuth (account linking) and game pass credits
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
ROBLOX_GAMEPASS_ID=25106617

# Discord OAuth (sign in and account linking)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# luaobfuscator.com API key for the obfuscation tool
LUAOBFUSCATOR_API_KEY=

# Sellix: site-wide subscription webhook secret, free trial product link
SELLIX_WEBHOOK_SECRET=
SELLIX_TRIAL_URL=

# Game API requests per minute per IP
API_RATE_LIMIT=60
